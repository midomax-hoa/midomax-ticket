# Copy thanh .env roi dien gia tri that. File .env KHONG duoc day len git.
# Tren Dokploy: dan noi dung nay vao tab "Environment" cua service.

# Dia chi that cua he thong
APP_BASE_URL=https://helpdesk.midomax.vn

# ===== MySQL (service dang chay san ben ngoai) =====
DB_HOST=
DB_PORT=3306
DB_NAME=helpdesk
DB_USERNAME=
DB_PASSWORD=
# validate: Hibernate chi kiem tra bang, khong tu sua DB
# update: cho Hibernate tu tao bang (chi dung lan dau khi DB con trong)
JPA_DDL_AUTO=validate

# ===== Tai khoan admin tao lan dau =====
# Dang nhap bang: admin / mat khau duoi day. Dat mat khau manh vao day.
SEED_ADMIN_PASSWORD=

# ===== MinIO =====
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=helpdesk-uploads
S3_ACCESS_KEY=
S3_SECRET_KEY=

# ===== Microsoft Entra ID / Graph API =====
AZURE_CLIENT_ID=
AZURE_TENANT_ID=
AZURE_CLIENT_SECRET=
AZURE_SENDER_EMAIL=it01@midomax.vn
