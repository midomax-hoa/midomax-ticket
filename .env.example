# Copy thanh .env roi dien gia tri that. File .env KHONG duoc day len git.
# Tren Dokploy: dan noi dung nay vao tab "Environment" cua service.

# Dia chi that cua he thong
APP_BASE_URL=https://helpdesk.midomax.vn

# ===== MySQL (service dang chay san ben ngoai) =====
DB_HOST=
DB_PORT=3306
DB_NAME=helpdesk
DB_USERNAME=
DB_PASSWORD=
# Flyway tu tao/sua bang theo file SQL trong db/migration, Hibernate chi kiem tra lai.
# De nguyen validate, dung doi thanh update.
JPA_DDL_AUTO=validate
# Cuu ho khi app chet voi loi "Migration checksum mismatch": doi thanh true,
# deploy 1 lan cho Flyway ghi lai checksum, roi TRA VE false va deploy lai.
FLYWAY_REPAIR=false

# ===== Tai khoan admin tao lan dau =====
# Dang nhap bang: admin / mat khau duoi day. Dat mat khau manh vao day.
SEED_ADMIN_PASSWORD=

# ===== MinIO =====
# Phai la URL day du co https:// (da gom ca port va SSL trong do)
MINIO_PUBLIC_URL=https://api-storge.midomax.vn
MINIO_BUCKET=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_REGION=us-east-1

# ===== Microsoft Entra ID / Graph API =====
AZURE_CLIENT_ID=
AZURE_TENANT_ID=
AZURE_CLIENT_SECRET=
AZURE_SENDER_EMAIL=it01@midomax.vn
